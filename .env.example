GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend origin. After GitHub login the browser is redirected here
# (default: http://localhost:5173). Set to an empty value to return JSON instead.
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quorum

# Context window management (Phase 7)
# Maximum prepared-analysis-context budget in estimated tokens
# (estimated as characters / CONTEXT_CHARS_PER_TOKEN).
CONTEXT_BUDGET_ESTIMATED_TOKENS=8000
# Characters assumed to equal one token when estimating context size.
CONTEXT_CHARS_PER_TOKEN=4
# Minimum context lines retained around changed lines when trimming context.
CONTEXT_MIN_CONTEXT_LINES=2

# Semgrep security analysis (Phase 8)
# Space-separated configs, each passed as its own `--config` flag.
# The default combines security-audit with owasp-top-ten (adds e.g. md5 checks).
SEMGREP_RULESET=p/security-audit p/owasp-top-ten
# Maximum seconds a Semgrep scan may run before it is aborted.
SEMGREP_TIMEOUT_SECONDS=120

# Docker sandbox (Phase 11)
# Image pre-built from docker/quorum-sandbox.Dockerfile (python + pytest).
SANDBOX_IMAGE=quorum-sandbox:latest
# Hard timeout: maximum seconds a sandboxed execution may run.
SANDBOX_TIMEOUT_SECONDS=60
# Container memory limit (docker --memory / --memory-swap).
SANDBOX_MEMORY_LIMIT=256m
# Container process limit (docker --pids-limit).
SANDBOX_PIDS_LIMIT=256
# Size of the container temporary filesystem (--tmpfs /tmp).
SANDBOX_TMPFS_SIZE=64m
# Working directory inside the container where the workspace is mounted.
SANDBOX_WORKDIR=/workspace

# LLM provider (Phase 9) — OpenAI is the active provider.
LLM_PROVIDER=openai

# OpenAI (paid). Never commit OPENAI_API_KEY.
# Intended model roles (already the defaults; change only if needed):
#   Security Agent -> GPT-5.6 Terra (gpt-5.6-terra)
#   Test Writer    -> GPT-5.6 Terra (gpt-5.6-terra)
#   Ask Quorum     -> GPT-5.6 Luna  (gpt-5.6-luna)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_SECURITY_MODEL=gpt-5.6-terra
OPENAI_TEST_MODEL=gpt-5.6-terra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=300

# Optional: a local Ollama provider also exists in code but is NOT in use.
# Set LLM_PROVIDER=ollama and add OLLAMA_* vars only if you enable it later.